{
  "name": "Termeta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "format:vue": "prettier --write \"src/**/*.vue\"",
    "check:format:vue": "prettier --check \"src/**/*.vue\"",
    "dev": "vite",
