    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "naive-ui": "2.45.3",
    "pinia": "4.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
