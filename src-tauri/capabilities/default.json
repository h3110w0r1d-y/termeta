{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-desktop",
  "description": "仅主桌面窗口可调用按用例授权的 SSH 与数据命令",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main"],
  "permissions": [
    "allow-cloud-backup-settings",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-destroy",
    "allow-available-session-kinds",
    "allow-list-serial-ports",
    "allow-open-session",
    "allow-write-session",
    "allow-resize-session",
    "allow-ack-session-output",
    "allow-respond-host-key",
    "allow-respond-auth-challenge",
    "allow-cancel-auth-challenge",
    "allow-close-session",
    "allow-list-sessions",
    "allow-get-session",
    "allow-session-client-heartbeat",
    "allow-vault-status",
    "allow-unlock-vault",
    "allow-change-vault-password",
    "allow-list-hosts",
    "allow-list-host-inventory",
    "allow-arrange-hosts",
    "allow-save-host",
    "allow-save-workspace",
    "allow-delete-host",
    "allow-list-host-groups",
    "allow-save-host-group",
    "allow-delete-host-group",
    "allow-list-known-hosts",
    "allow-revoke-known-host",
    "allow-list-credentials",
    "allow-credential-public-key",
    "allow-save-credential",
    "allow-delete-credential",
    "allow-get-settings",
    "allow-save-settings",
    "allow-open-external-url",
    "allow-export-json",
    "allow-list-snippets",
    "allow-save-snippet",
    "allow-delete-snippet",
    "allow-save-session-log",
    "allow-list-session-logs",
    "allow-read-session-log",
    "allow-delete-session-log",
    "allow-clear-session-logs",
    "allow-finish-app-exit",
    "allow-sftp-connect",
    "allow-sftp-copy",
    "allow-sftp-drop-upload",
    "allow-sftp-start-drag",
    "allow-sftp-list",
    "allow-sftp-delete",
    "allow-sftp-set-permissions",
    "allow-sftp-transfer",
    "allow-sftp-cancel",
    "allow-open-settings-window",
    "allow-set-native-menu-locale",
    "allow-list-port-forwards",
    "allow-save-port-forward",
    "allow-delete-port-forward",
    "allow-start-port-forward",
    "allow-stop-port-forward"
  ]
}
